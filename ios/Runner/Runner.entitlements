<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links for shared recipe URLs. Needs the Associated Domains
	     capability on the App ID and /.well-known/apple-app-site-association
	     on the site (see RELEASE.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sliceofgourmet.com</string>
		<string>applinks:www.sliceofgourmet.com</string>
	</array>
</dict>
</plist>
